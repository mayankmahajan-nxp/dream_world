  <library_effects>
    <effect id="Material_006-effect">
      <profile_COMMON>
        <newparam sid="blue_webp_001-surface">
          <surface type="2D">
            <init_from>blue_webp_001</init_from>
          </surface>
        </newparam>
        <newparam sid="blue_webp_001-sampler">
          <sampler2D>
            <source>blue_webp_001-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="blue_webp_001-sampler" texcoord="UVMap"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.45</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
